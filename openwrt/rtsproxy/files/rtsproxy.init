#!/etc/rc.common

START=99
USE_PROCD=1

CONF="rtsproxy"
PROG="/usr/bin/rtsproxy"
rewrite_rule_count=0

append_upstream_route() {
	local section="$1"
	local cidr interface
	config_get cidr "$section" cidr
	config_get interface "$section" interface
	[ -n "$cidr" ] && [ -n "$interface" ] &&
		procd_append_param command --upstream-route "$cidr,$interface"
}

append_blacklist() {
	[ -n "$1" ] && procd_append_param command --blacklist "$1"
}

append_rewrite_rule() {
	local section="$1"
	local action match replacement shift_hours
	config_get action "$section" action
	config_get match "$section" match
	[ -z "$match" ] && return
	rewrite_rule_count=$((rewrite_rule_count + 1))
	case "$action" in
		remove)
			procd_append_param command --rewrite-remove "$match"
			;;
		replace)
			config_get replacement "$section" replacement
			procd_append_param command --rewrite-match "$match"
			procd_append_param command --rewrite-with "$replacement"
			;;
		timeshift)
			config_get shift_hours "$section" shift_hours 0
			procd_append_param command --timeshift-match "$match"
			procd_append_param command --timeshift-hours "$shift_hours"
			;;
	esac
}

start_service() {
	local enabled
	local port
	local enable_nat
	local buffer_pool_count
	local buffer_pool_block_size
	local auth_token
	local listen_interface
	local watchdog
	local log_file
	local log_lines
	local log_level
	local nat_method
	local stun_host
	local stun_port
	local strip_padding
	local wait_keyframe
	local default_blacklist

	config_load "$CONF"
	config_get_bool enabled "main" "enabled" 0
	[ "$enabled" -eq 0 ] && return

	config_get port "main" "port" "8554"
	config_get_bool enable_nat "main" "enable_nat" 0
	config_get nat_method "main" "nat_method" "stun"
	config_get stun_host "main" "stun_host" "stun.l.google.com"
	config_get stun_port "main" "stun_port" "19302"
	config_get buffer_pool_count "main" "buffer_pool_count" "8192"
	config_get buffer_pool_block_size "main" "buffer_pool_block_size" "2048"
	config_get auth_token "main" "auth_token" ""
	config_get listen_interface "main" "listen_interface" ""
	config_get_bool watchdog "main" "watchdog" 1
	config_get log_file "main" "log_file" ""
	config_get log_lines "main" "log_lines" "10000"
	config_get log_level "main" "log_level" "info"
	config_get_bool strip_padding "main" "strip_padding" 0
	config_get_bool wait_keyframe "main" "wait_keyframe" 0
	config_get_bool default_blacklist "main" "default_blacklist" 1

	procd_open_instance
	procd_set_param command "$PROG"
	procd_append_param command --clear-rewrite-rules
	procd_append_param command -p "$port"
	procd_append_param command -b "$buffer_pool_count"
	procd_append_param command -s "$buffer_pool_block_size"
	[ "$enable_nat" -eq 1 ] && procd_append_param command -n
	[ "$enable_nat" -eq 1 ] && procd_append_param command --nat-method "$nat_method"
	[ "$enable_nat" -eq 1 ] && [ "$nat_method" = "stun" ] && [ -n "$stun_host" ] && procd_append_param command --stun-host "$stun_host"
	[ "$enable_nat" -eq 1 ] && [ "$nat_method" = "stun" ] && [ -n "$stun_port" ] && procd_append_param command --stun-port "$stun_port"
	[ -n "$auth_token" ] && procd_append_param command -t "$auth_token"
	config_foreach append_upstream_route upstream_route
	[ "$default_blacklist" -eq 0 ] && procd_append_param command --clear-blacklist
	config_list_foreach "main" "blacklist" append_blacklist
	config_foreach append_rewrite_rule rewrite
	if [ "$rewrite_rule_count" -eq 0 ]; then
		procd_append_param command --rewrite-remove '/{number}_Uni.sdp'
		procd_append_param command --rewrite-match '/iptv/import'
		procd_append_param command --rewrite-with '/iptv'
		procd_append_param command --rewrite-match 'tvdr={number}-{number}'
		procd_append_param command --rewrite-with 'tvdr={number}GMT-{number}GMT'
		procd_append_param command --timeshift-match 'tvdr={number}GMT-{number}GMT'
		procd_append_param command --timeshift-hours '-6'
	fi
	[ -n "$listen_interface" ] && procd_append_param command -l "$listen_interface"
	[ -n "$log_file" ] && procd_append_param command --log-file "$log_file"
	[ -n "$log_lines" ] && procd_append_param command --log-lines "$log_lines"
	[ -n "$log_level" ] && procd_append_param command --log-level "$log_level"
	[ "$strip_padding" -eq 1 ] && procd_append_param command --strip-padding
	[ "$wait_keyframe" -eq 1 ] && procd_append_param command --wait-keyframe
	
	[ "$watchdog" -eq 1 ] && procd_append_param command -w

	# Run in background via procd
	procd_set_param respawn
	if [ -z "$log_file" ]; then
		procd_set_param stderr 1
		procd_set_param stdout 1
	fi
	procd_close_instance
}

stop_service() {
	return 0
}

service_triggers() {
	procd_add_reload_trigger "$CONF"
}

# End of script
